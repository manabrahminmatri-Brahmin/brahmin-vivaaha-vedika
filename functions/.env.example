# Copy to .env.local for local emulation. Production: use Firebase Secret Manager
# (firebase functions:secrets:set) for RAZORPAY_* values — do not commit real secrets.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay API (server)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# Webhook signing secret ONLY from:
# Razorpay Dashboard → Settings → Webhooks → [your endpoint] → "Secret"
# This string is NOT the same as RAZORPAY_KEY_ID.
RAZORPAY_WEBHOOK_SECRET=

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Run with Dart Defines",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define-from-file",
        "dart_defines.json"
      ]
    },
    {
      "name": "Flutter: Profile with Dart Defines",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define-from-file",
        "dart_defines.json"
      ]
    },
    {
      "name": "Flutter: Release with Dart Defines",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define-from-file",
        "dart_defines.json"
      ]
    }
  ]
}

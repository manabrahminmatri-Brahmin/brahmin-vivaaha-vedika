rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Check if the requesting user owns this document via auth_uid field
    function isOwnerViaAuthUid(userDocId) {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/users/$(userDocId)) &&
        firestore.get(/databases/(default)/documents/users/$(userDocId)).data.get('auth_uid', '') == request.auth.uid;
    }

    // Helper: Check if the file belongs to the requesting user
    // Profile photos: profile_photos/{userId}/... (userId is the phone-based Firestore doc ID)
    function isProfilePhotoOwner(path) {
      return isAuth() &&
        path.matches('^profile_photos/') &&
        path.split('/')[1] != null &&
        isOwnerViaAuthUid(path.split('/')[1]);
    }

    // Profile photos - allow authenticated reads, owner-only writes
    match /profile_photos/{userId}/{allPaths=**} {
      // Allow read if authenticated (any authenticated user can view profile photos)
      allow read: if isAuth();

      // Allow write (upload/update/delete) only if the user owns this profile via auth_uid
      allow write: if isAuth() && isOwnerViaAuthUid(userId);

      // Allow delete only if owner
      allow delete: if isAuth() && isOwnerViaAuthUid(userId);
    }

    // Verification documents - owner and admin only
    match /verification_docs/{userId}/{allPaths=**} {
      allow read: if isAuth() && (
        isOwnerViaAuthUid(userId) ||
        (firestore.exists(/databases/(default)/documents/admin_sessions/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_sessions/$(request.auth.uid)).data.get('is_admin', false) == true)
      );
      allow write: if isAuth() && isOwnerViaAuthUid(userId);
      allow delete: if isAuth() && (
        isOwnerViaAuthUid(userId) ||
        (firestore.exists(/databases/(default)/documents/admin_sessions/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_sessions/$(request.auth.uid)).data.get('is_admin', false) == true)
      );
    }

    // Success story photos - authenticated users can read, owners/admins can write
    match /success_stories/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        isOwnerViaAuthUid(request.resource.name.split('/')[1]) ||
        (firestore.exists(/databases/(default)/documents/admin_sessions/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admin_sessions/$(request.auth.uid)).data.get('is_admin', false) == true)
      );
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
